---
import Card from "./Card.astro";
import CardBody from "./CardBody.astro";
import FormattedDate from "./FormattedDate.astro";

const { post } = Astro.props;
---

<Card>
  <div class="img-container">
    {post.data.image && <img src={post.data.image} alt={post.data.title} loading="lazy" />}
    {
      !post.data.image && (
        <img
          src={`https://via.placeholder.com/600x300?text=${encodeURIComponent(post.data.title)}`}
          alt={post.data.title}
          loading="lazy"
        />
      )
    }
  </div>
  <CardBody>
    <div>
      <h2><a class="card-link" href={`/posts/${post.slug}/`} title={`Read ${post.data.title} by Dan Klco`}>{post.data.title}</a></h2>
      <FormattedDate date={post.data.pubDate} />
    </div>
    <p>{post.data.description}</p>
  </CardBody>
</Card>

<style>
  h2 {
    margin: 0;
    font-size: xx-large;
  }
  h2 a {
    color: black
  }
</style>
