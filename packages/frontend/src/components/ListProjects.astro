---
import { getCollection } from "astro:content";
import Card from "./Card.astro";
import CardBody from "./CardBody.astro";
import FormattedDate from "./FormattedDate.astro";
import Grid from "./Grid.astro";

const { format } = Astro.props;

const projects = (await getCollection("projects")).reverse();
---

<div class="projects">
  {
    format === "card" && (
      <Grid>
        {projects.map((project) => {
          return (
            <Card>
              <div class="img-container">
                <img src={project.data.image} alt={project.data.title} loading="lazy" />
              </div>
              <CardBody>
                <h2><a class="card-link" href={`/projects/${project.slug}/`} title={project.data.title}>{project.data.title}</a></h2>
                <p>{project.data.description}</p>
              </CardBody>
            </Card>
          );
        })}
      </Grid>
    )
  }

  {
    format !== "card" && (
      <>
        {projects.map((project) => {
          return (
            <section class="project client">
              <h3>
                <a
                  href={`/projects/${project.slug}/`}
                  title={project.data.title}
                >
                  {project.data.title}
                </a>
                <span class="pull-right">
                  <FormattedDate
                    date={project.data.startDate}
                    excludeDay={true}
                  />{" "}
                  -{" "}
                  <FormattedDate
                    date={project.data.endDate}
                    excludeDay={true}
                  />
                </span>
              </h3>
              <p>
                <em>{project.data.projectRole}</em>
              </p>
              <ul class="tasks">
                {project.data.tasks.map((task: unknown) => (
                  <li>{task}</li>
                ))}
              </ul>
              Tools Used:
              <ul class="list-inline">
                {project.data.tools.map((tool: unknown) => (
                  <li>{tool}</li>
                ))}
              </ul>
            </section>
          );
        })}
      </>
    )
  }
</div>

<style>
  h2 {
    margin: 0;
    font-size: xx-large;
  }
  h3 {
    display:flex;
    font-size: xx-large;
    gap: 1em;
    justify-content: space-between;
  }
</style>
