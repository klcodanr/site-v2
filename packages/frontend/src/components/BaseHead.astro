---
import '../styles/global.css';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image } = Astro.props;
const pageTitle = title ? `${title} | Dan Klco` : 'Dan Klco';
const pageDescription = description || 'Adobe Experience Manager, Apache Sling, and digital experience architect helping teams build scalable content and marketing systems.';
const ogImage = image ? new URL(image, Astro.url) : new URL('/images/dan-klco-profile.jpg', Astro.url);
const siteUrl = Astro.site || 'https://danklco.com';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={pageDescription} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="author" content="Dan Klco" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={pageDescription} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={new URL(Astro.url.pathname, siteUrl)} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content="Dan Klco" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={new URL(Astro.url.pathname, siteUrl)} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={pageDescription} />
<meta property="twitter:image" content={ogImage} />

<!-- Person / Brand identity -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Dan Klco',
  url: 'https://danklco.com/',
  sameAs: [
    'https://www.linkedin.com/in/danklco/',
    'https://github.com/klcodanr',
    'https://www.adobe.com',
  ],
  jobTitle: 'Adobe Experience Manager and Digital Experience Architect',
  description: 'Dan Klco helps teams design and deliver effective digital experience systems, content platforms, and marketing technology strategies.',
  image: 'https://danklco.com/images/dan-klco-profile.jpg',
  knowsAbout: [
    'Adobe Experience Manager',
    'Apache Sling',
    'Digital Experience Architecture',
    'Content Management',
    'Digital Marketing Technology',
    'Generative AI for Marketing'
  ],
  mainEntityOfPage: 'https://danklco.com/'
})}></script>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Dan Klco',
  url: 'https://danklco.com/',
  description: 'Adobe Experience Manager, Apache Sling, and digital experience architect helping teams build scalable content and marketing systems.',
  inLanguage: 'en',
  publisher: {
    '@type': 'Person',
    name: 'Dan Klco'
  }
})}></script>
