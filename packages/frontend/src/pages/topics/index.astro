---
import Content from "../../layouts/Content.astro";
import { getCollection } from "astro:content";
import { TOPICS } from "../../data/topics";

const posts = await getCollection("posts");
const topics = Object.entries(TOPICS).map(([slug, topic]) => ({
  slug,
  ...topic,
  postCount: posts.filter(
    (post) =>
      post.data.published &&
      !post.data.hideInNav &&
      post.data.tags.some((tag) => topic.tags.some((topicTag) => tag.toLowerCase() === topicTag.toLowerCase())),
  ).length,
}));
---

<Content
  title="Topics"
  description="Explore my writing and first-hand experience across content management, digital marketing architecture, software architecture, and technology consulting."
>
  <h1>Explore by topic</h1>
  <p class="intro">Browse my practical, first-hand experience across the systems, strategies, and decisions involved in building digital experiences.</p>
  <div class="topic-grid">
    {topics.map((topic) => (
      <a class="topic-card" href={`/topics/${topic.slug}/`}>
        <span class="topic-count">{topic.postCount} {topic.postCount === 1 ? "article" : "articles"}</span>
        <h2>{topic.title}</h2>
        <p>{topic.description}</p>
        <span class="topic-link">Explore topic →</span>
      </a>
    ))}
  </div>
</Content>

<style>
  .intro {
    max-width: 46rem;
    font-size: 1.2rem;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    min-height: 15rem;
    padding: 1.5rem;
    border: 1px solid var(--gray-light);
    border-top: 5px solid var(--gray-dark);
    color: inherit;
    text-decoration: none;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .topic-card:hover,
  .topic-card:focus-visible {
    transform: translateY(-0.2rem);
    box-shadow: 0 0.5rem 1.25rem rgba(var(--black), 12%);
  }

  .topic-card h2 {
    margin: 0.5rem 0;
  }

  .topic-card p {
    flex: 1;
  }

  .topic-count,
  .topic-link {
    font-weight: bold;
  }

  .topic-count {
    color: var(--gray-dark);
    font-size: 0.9rem;
    text-transform: uppercase;
  }

  .topic-link {
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .topic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
