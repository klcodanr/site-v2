---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead {...Astro.props} title={title} description={description} />
  </head>

  <body>
    <Header />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style is:global>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: .5rem 1rem;
    background: white;
    color: var(--gray-dark);
  }
  .skip-link:focus {
    top: 1rem;
  }
</style>
